generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role{
  User
  Admin
}

model Note {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}


model User{
  id         Int    @id @default(autoincrement())
  name      String
  email     String @unique
  password  String
  role      Role   @default(User) 
  createdAt DateTime @default(now())
}